<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Exclude sensitive preferences, cached tokens, and credentials from cloud backups -->
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <!-- Exclude sensitive preferences from device-to-device transfers -->
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
